# Replace each placeholder key with a real key before running the corresponding mode.
# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # arc_runner, openai, or gemini
ARC_RUNNER_BASE_URL=http://127.0.0.1:11434
ARC_RUNNER_MODEL=llama-3.2-3b
ARC_RUNNER_TIMEOUT=120.0
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# YouTube anti-403 cookies (optional)
# YTDLP_COOKIES_PATH=cookies.txt
