# API mode (default). You can enter this in Settings for a session-only key.
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local). Settings can supply session-only provider keys too.
LLM_PROVIDER=openai           # openai, gemini, or ollama
SHORTS_ENVIRONMENT=development # development, test, staging, or production
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional creator-entered rate defaults (USD per million tokens). Leave zero
# when a provider does not report usage or the current rate is unknown.
SHORTS_OPENAI_INPUT_USD_PER_MILLION=0
SHORTS_OPENAI_OUTPUT_USD_PER_MILLION=0
SHORTS_GEMINI_INPUT_USD_PER_MILLION=0
SHORTS_GEMINI_OUTPUT_USD_PER_MILLION=0
SHORTS_MUAPI_INPUT_USD_PER_MILLION=0
SHORTS_MUAPI_OUTPUT_USD_PER_MILLION=0
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
LOCAL_BURN_CAPTIONS=true
LOCAL_HEURISTIC_FALLBACK=true
LOCAL_AUTO_SELECT_WHISPER_MODEL=false
LOCAL_ENCODE_PRESET=fast
LOCAL_CRF=20
LOCAL_AUDIO_BITRATE=128k
LOCAL_OUTPUT_TEMPLATE=short_{index:02d}.mp4
LOCAL_MAX_FFMPEG_PROCS=2
SHORTS_RENDER_WORKERS=2
SHORTS_RESPONSE_CACHE_SECONDS=10
LOCAL_TEMP_DIR=
LOCAL_CAPTION_PRESETS_FILE=
LOCAL_THUMBNAIL_POSITION=0.5
LOCAL_RANGE_MERGE_TOLERANCE=0.35
LOCAL_LLM_MAX_RETRIES=5
LOCAL_LLM_RETRY_DELAY_SECONDS=30
LOCAL_LLM_MAX_OUTPUT_TOKENS=32768
LOCAL_LLM_TIMEOUT_SECONDS=300
MUAPI_RETRY_DELAY_SECONDS=5
HIGHLIGHT_MIN_DURATION_SECONDS=2
HIGHLIGHT_MAX_DURATION_SECONDS=180
HIGHLIGHT_CHUNK_SIZE_SECONDS=1200
HIGHLIGHT_CHUNK_OVERLAP_SECONDS=60
HIGHLIGHT_DEDUPE_OVERLAP=0.5
HIGHLIGHT_MAX_CLIPS=12
HIGHLIGHT_MAX_API_ATTEMPTS=3
SHORTS_FACE_DETECTOR=auto  # auto, dnn, haar, or off
# Optional OpenCV SSD files; auto uses them when both paths exist.
SHORTS_FACE_DNN_MODEL=
SHORTS_FACE_DNN_CONFIG=
SHORTS_MAX_UPLOAD_MB=2048
SHORTS_MAX_JSON_MB=2
# Desktop shell defaults to an embedded WebView2 window. Set to true to force
# the legacy browser launcher.
SHORTS_STUDIO_BROWSER=false
SHORTS_PORT=7860
SHORTS_AUTO_RESUME=true
SHORTS_MIN_FREE_GB=0.5
SHORTS_ALLOW_EXTERNAL_PATHS=false
SHORTS_ALLOWED_REMOTE_HOSTS=
SHORTS_MAX_MEDIA_OPERATIONS=2
SHORTS_CORS_ORIGINS=
SHORTS_TRUSTED_PROXIES=
# Set sqlite when multiple workers share SHORTS_STUDIO_DATA_DIR.
SHORTS_RATE_LIMIT_BACKEND=memory
SHORTS_RATE_LIMIT_STORE=
# Optional approval-first YouTube publishing foundation. Enter the client
# secret only in your local .env or deployment secret manager.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:7860/api/youtube/oauth/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.force-ssl
# Both flags are opt-in safety gates. Keep them false for approval-only use.
SHORTS_YOUTUBE_AUTO_PUBLISH=false
SHORTS_YOUTUBE_ALLOW_PUBLIC_AUTOPUBLISH=false
# Optional direct TikTok Content Posting API credentials (process-memory use).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OAUTH_REDIRECT_URI=http://127.0.0.1:7860/api/tiktok/oauth/callback
# Optional Instagram Graph API credentials. Reels require a public media URL.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_OAUTH_REDIRECT_URI=http://127.0.0.1:7860/api/instagram/oauth/callback
SHORTS_STRUCTURED_LOGS=false
SHORTS_REQUIRE_SIGNED_UPDATES=true
