# Copy this file to .env (or pass these variables through your deployment
# platform). Secrets are read at runtime and are never baked into the image.

# Optional hosted/API mode credential.
MUAPI_API_KEY=

# Optional local highlight-ranking credentials.
LLM_PROVIDER=openai
SHORTS_ENVIRONMENT=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
SHORTS_OPENAI_INPUT_USD_PER_MILLION=0
SHORTS_OPENAI_OUTPUT_USD_PER_MILLION=0
SHORTS_GEMINI_INPUT_USD_PER_MILLION=0
SHORTS_GEMINI_OUTPUT_USD_PER_MILLION=0
SHORTS_MUAPI_INPUT_USD_PER_MILLION=0
SHORTS_MUAPI_OUTPUT_USD_PER_MILLION=0

# Local rendering defaults.
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_BURN_CAPTIONS=true
LOCAL_HEURISTIC_FALLBACK=true
LOCAL_AUTO_SELECT_WHISPER_MODEL=false
LOCAL_ENCODE_PRESET=fast
LOCAL_CRF=20
LOCAL_AUDIO_BITRATE=128k
LOCAL_OUTPUT_TEMPLATE=short_{index:02d}.mp4
LOCAL_MAX_FFMPEG_PROCS=2
LOCAL_LLM_MAX_RETRIES=5
LOCAL_LLM_RETRY_DELAY_SECONDS=30
LOCAL_LLM_MAX_OUTPUT_TOKENS=32768
LOCAL_LLM_TIMEOUT_SECONDS=300
MUAPI_RETRY_DELAY_SECONDS=5
HIGHLIGHT_MIN_DURATION_SECONDS=2
HIGHLIGHT_MAX_DURATION_SECONDS=180
HIGHLIGHT_CHUNK_SIZE_SECONDS=1200
HIGHLIGHT_CHUNK_OVERLAP_SECONDS=60
HIGHLIGHT_DEDUPE_OVERLAP=0.5
HIGHLIGHT_MAX_CLIPS=12
HIGHLIGHT_MAX_API_ATTEMPTS=3
SHORTS_FACE_DETECTOR=auto
SHORTS_FACE_DNN_MODEL=
SHORTS_FACE_DNN_CONFIG=
SHORTS_MAX_UPLOAD_MB=2048
SHORTS_MAX_JSON_MB=2
SHORTS_MIN_FREE_GB=0.5
SHORTS_ALLOW_EXTERNAL_PATHS=false
SHORTS_AUTO_RESUME=true
SHORTS_STUDIO_HEADLESS=true
SHORTS_ALLOWED_REMOTE_HOSTS=
SHORTS_MAX_MEDIA_OPERATIONS=2

# Optional API authentication and abuse protection. Leave the token blank for
# a loopback-only desktop-style deployment; set a long random value when the
# service is reachable from another machine.
SHORTS_API_TOKEN=
SHORTS_RATE_LIMIT_PER_MINUTE=600
SHORTS_UPLOAD_RATE_LIMIT_PER_MINUTE=10
SHORTS_JOB_RATE_LIMIT_PER_MINUTE=30
# SQLite counters are shared by multiple workers on the mounted /data volume.
SHORTS_RATE_LIMIT_BACKEND=sqlite
SHORTS_RATE_LIMIT_STORE=/data/rate_limits.sqlite3
# Configure these through a secret manager; values are intentionally blank.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:7860/api/youtube/oauth/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload
# Only enable this when a trusted reverse proxy overwrites X-Forwarded-For.
SHORTS_TRUSTED_PROXIES=
SHORTS_CORS_ORIGINS=
SHORTS_STRUCTURED_LOGS=false
SHORTS_REQUIRE_SIGNED_UPDATES=true

# Host ports. The Compose file binds them to loopback by default.
SHORTS_PORT=7860
SHORTS_GPU_PORT=7861
