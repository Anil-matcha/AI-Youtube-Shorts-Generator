# Copy this file to .env (or pass these variables through your deployment
# platform). Secrets are read at runtime and are never baked into the image.

# Optional hosted/API mode credential.
MUAPI_API_KEY=

# Optional local highlight-ranking credentials.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local rendering defaults.
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_BURN_CAPTIONS=true
LOCAL_HEURISTIC_FALLBACK=true
SHORTS_FACE_DETECTOR=auto
SHORTS_FACE_DNN_MODEL=
SHORTS_FACE_DNN_CONFIG=
SHORTS_MAX_UPLOAD_MB=2048
SHORTS_MAX_JSON_MB=2
SHORTS_MIN_FREE_GB=0.5
SHORTS_AUTO_RESUME=true
SHORTS_STUDIO_HEADLESS=true

# Host ports. The Compose file binds them to loopback by default.
SHORTS_PORT=7860
SHORTS_GPU_PORT=7861
